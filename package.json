{
  "name": "mterminal",
  "version": "0.1.4",
  "private": true,
  "description": "A focused terminal and SFTP workspace",
  "author": "MTerminal",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && node scripts/pack-mac.mjs",
    "dist": "npm run pack && node scripts/dmg.mjs",
    "dist:win": "node scripts/build-windows.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "electron tests/integration.cjs",
    "test:smoke": "electron tests/window-smoke.cjs",
    "test:ui": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.61.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "happy-dom": "^21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "local.mterminal.desktop",
    "productName": "MTerminal",
    "asar": true,
    "afterPack": "scripts/mac-identity.cjs",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "assets/THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "mac": {
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "MTerminal 需要连接你指定的局域网或虚拟局域网主机，以使用 SSH 终端和 SFTP 文件管理。"
      },
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-"
    }
  }
}
